<%- include('../../partials/head') %>
<%
  var payInfo = {
    efectivo: { ico: '💵', label: 'Efectivo', help: 'Paga en efectivo al recibir tu pedido. Indica en la nota si necesitas cambio.' },
    tarjeta: { ico: '💳', label: 'Tarjeta débito o crédito', help: 'El domiciliario lleva datáfono para pagar al recibir.' },
    transferencia: { ico: '🏦', label: 'Transferencia', help: cart.store.bank_info },
    cripto: { ico: '🪙', label: 'Criptomonedas', help: cart.store.crypto_wallet }
  };
  function err(f) { return errors[f] ? '<div class="error">' + errors[f] + '</div>' : ''; }
%>

<a href="/carrito" class="small">‹ Volver al carrito</a>
<h1 style="margin-top:8px">Datos de entrega</h1>
<% if (errors.general) { %><div class="alert alert-error"><%= errors.general %></div><% } %>

<form method="post" action="/checkout" novalidate data-checkout>
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <div class="two-col">
    <div>
      <div class="card">
        <h2>¿Quién recibe?</h2>
        <div class="row-2">
          <div class="field <%= errors.firstName ? 'has-error' : '' %>">
            <label for="firstName">Nombre</label>
            <input type="text" id="firstName" name="firstName" value="<%= values.firstName || '' %>" autocomplete="given-name" required>
            <%- err('firstName') %>
          </div>
          <div class="field <%= errors.lastName ? 'has-error' : '' %>">
            <label for="lastName">Apellidos</label>
            <input type="text" id="lastName" name="lastName" value="<%= values.lastName || '' %>" autocomplete="family-name" required>
            <%- err('lastName') %>
          </div>
        </div>
        <div class="field <%= errors.phone ? 'has-error' : '' %>">
          <label for="phone">Celular</label>
          <input type="tel" id="phone" name="phone" value="<%= values.phone || '' %>" inputmode="tel" autocomplete="tel" placeholder="300 123 4567" required>
          <%- err('phone') %>
        </div>
      </div>

      <div class="card">
        <h2>¿A dónde lo llevamos?</h2>
        <div class="field <%= errors.address ? 'has-error' : '' %>">
          <label for="address">Dirección</label>
          <input type="text" id="address" name="address" value="<%= values.address || '' %>" autocomplete="street-address" placeholder="Calle 10 # 20-30, apto 201" required>
          <%- err('address') %>
        </div>
        <div class="field">
          <label for="reference">Referencia <span class="muted">(opcional)</span></label>
          <input type="text" id="reference" name="reference" value="<%= values.reference || '' %>" placeholder="Casa de rejas verdes, frente al parque">
        </div>
        <div class="field">
          <label for="notes">Nota para la tienda <span class="muted">(opcional)</span></label>
          <textarea id="notes" name="notes" placeholder="Ej: el pan bien tostado, traer cambio de $50.000"><%= values.notes || '' %></textarea>
        </div>
        <% if (!location) { %>
          <div class="alert alert-info small">Consejo: activa tu ubicación (📍 arriba) para que el domiciliario te encuentre más rápido.</div>
        <% } %>
      </div>
    </div>

    <div class="sticky">
      <div class="card">
        <h2>Método de pago</h2>
        <div class="pay-options">
          <% payments.forEach(function (p) { %>
            <label class="pay-option">
              <input type="radio" name="payment" value="<%= p %>" <%= values.payment === p ? 'checked' : '' %> required>
              <span class="ico"><%= payInfo[p].ico %></span>
              <span><strong><%= payInfo[p].label %></strong></span>
            </label>
            <div class="pay-detail hidden" data-pay-detail="<%= p %>"><%= payInfo[p].help %><% if (p === 'transferencia' || p === 'cripto') { %>

Envía el comprobante a la tienda por WhatsApp después de hacer el pedido.<% } %></div>
          <% }) %>
        </div>
        <%- err('payment') %>
      </div>

      <div class="card">
        <h2>Resumen</h2>
        <div class="small muted" style="margin-bottom:8px">🏪 <%= cart.store.name %> · <%= cart.count %> producto<%= cart.count === 1 ? '' : 's' %></div>
        <div class="totals">
          <div><span>Subtotal</span><span><%= fmt.formatMoney(cart.subtotal) %></span></div>
          <div><span>Domicilio</span><span><%= cart.deliveryFee ? fmt.formatMoney(cart.deliveryFee) : 'Gratis' %></span></div>
          <div class="grand"><span>Total</span><span><%= fmt.formatMoney(cart.total) %></span></div>
        </div>
        <button class="btn btn-green btn-block" style="margin-top:14px" data-submit>Hacer pedido · <%= fmt.formatMoney(cart.total) %></button>
      </div>
    </div>
  </div>
</form>

<%- include('../../partials/foot') %>
