<% locals.withMap = true; locals.scripts = ['/js/owner.js'] %>
<%- include('../../partials/head') %>
<% function err(f) { return errors[f] ? '<div class="error">' + errors[f] + '</div>' : ''; } %>
<div style="max-width:640px;margin:0 auto">
  <h1>Registra tu tienda</h1>
  <p class="muted">En 2 minutos empiezas a recibir pedidos de tu barrio.</p>
  <form method="post" action="/tendero/registro" novalidate>
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <div class="card">
      <h2>Tus datos</h2>
      <div class="field <%= errors.fullName ? 'has-error' : '' %>">
        <label for="fullName">Nombre completo</label>
        <input type="text" id="fullName" name="fullName" value="<%= values.fullName || '' %>" autocomplete="name" required>
        <%- err('fullName') %>
      </div>
      <div class="row-2">
        <div class="field <%= errors.email ? 'has-error' : '' %>">
          <label for="email">Correo</label>
          <input type="email" id="email" name="email" value="<%= values.email || '' %>" autocomplete="email" required>
          <%- err('email') %>
        </div>
        <div class="field">
          <label for="phone">Celular</label>
          <input type="tel" id="phone" name="phone" value="<%= values.phone || '' %>" inputmode="tel">
        </div>
      </div>
      <div class="field <%= errors.password ? 'has-error' : '' %>">
        <label for="password">Contraseña</label>
        <input type="password" id="password" name="password" autocomplete="new-password" minlength="8" required>
        <div class="hint">Mínimo 8 caracteres</div>
        <%- err('password') %>
      </div>
    </div>

    <div class="card">
      <h2>Tu tienda</h2>
      <div class="field <%= errors.storeName ? 'has-error' : '' %>">
        <label for="storeName">Nombre de la tienda</label>
        <input type="text" id="storeName" name="storeName" value="<%= values.storeName || '' %>" placeholder="Tienda Doña Rosa" required>
        <%- err('storeName') %>
      </div>
      <div class="row-2">
        <div class="field <%= errors.address ? 'has-error' : '' %>">
          <label for="address">Dirección</label>
          <input type="text" id="address" name="address" value="<%= values.address || '' %>" required>
          <%- err('address') %>
        </div>
        <div class="field">
          <label for="neighborhood">Barrio</label>
          <input type="text" id="neighborhood" name="neighborhood" value="<%= values.neighborhood || '' %>">
        </div>
      </div>
      <div class="row-2">
        <div class="field <%= errors.whatsapp ? 'has-error' : '' %>">
          <label for="whatsapp">WhatsApp para recibir pedidos</label>
          <input type="tel" id="whatsapp" name="whatsapp" value="<%= values.whatsapp || '' %>" inputmode="tel" placeholder="300 123 4567" required>
          <%- err('whatsapp') %>
        </div>
        <div class="field">
          <label for="deliveryFee">Valor del domicilio</label>
          <input type="number" id="deliveryFee" name="deliveryFee" value="<%= values.deliveryFee || 0 %>" min="0" step="100" inputmode="numeric">
          <div class="hint">Escribe 0 si el domicilio es gratis</div>
        </div>
      </div>
      <%- include('../../partials/locationPicker', { lat: values.latitude, lng: values.longitude }) %>
    </div>
    <button class="btn btn-block">Crear mi tienda</button>
  </form>
  <p class="center">¿Ya tienes cuenta? <a href="/tendero/ingresar">Ingresa</a></p>
</div>
<%- include('../../partials/foot') %>
